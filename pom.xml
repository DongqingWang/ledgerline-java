<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.3</version>
    <relativePath/>
  </parent>

  <groupId>dev.ledgerline</groupId>
  <artifactId>ledgerline-java</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <name>Ledgerline (Java)</name>
  <description>
    Java/Spring Boot/Apache Ratis port of Ledgerline -- an original,
    open-source distributed ledger platform (Raft consensus, event
    sourcing, CQRS, double-entry bookkeeping). Not derived from, and
    contains no code from, any proprietary system.
  </description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <ratis.version>3.2.2</ratis.version>
  </properties>

  <modules>
    <module>ledgerline-common</module>
    <module>ledgerline-raft</module>
    <module>ledgerline-accounting-core</module>
    <module>ledgerline-gateway</module>
    <module>ledgerline-balance-reader</module>
    <module>ledgerline-persistence-sync</module>
    <module>ledgerline-fx</module>
    <module>ledgerline-orchestrator</module>
    <module>ledgerline-reporting</module>
    <module>ledgerline-ai-gateway</module>
    <module>ledgerline-admin-console</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.apache.ratis</groupId>
        <artifactId>ratis-server</artifactId>
        <version>${ratis.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.ratis</groupId>
        <artifactId>ratis-client</artifactId>
        <version>${ratis.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.ratis</groupId>
        <artifactId>ratis-grpc</artifactId>
        <version>${ratis.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.ratis</groupId>
        <artifactId>ratis-common</artifactId>
        <version>${ratis.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.ratis</groupId>
        <artifactId>ratis-proto</artifactId>
        <version>${ratis.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
